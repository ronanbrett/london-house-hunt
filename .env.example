# Copy to .env and fill in. All free to obtain.

# EPC register API — register at https://epc.opendatacommunities.org/ (email + key)
NUXT_EPC_API_EMAIL=
NUXT_EPC_API_KEY=

# TfL Unified API — register at https://api-portal.tfl.gov.uk/ (optional, raises rate limits)
NUXT_TFL_APP_KEY=

# MapTiler — free vector map tiles, https://www.maptiler.com/ (optional; OSM raster fallback otherwise)
NUXT_PUBLIC_MAPTILER_KEY=

# Local DB location (defaults to file:./data/app.db)
# NUXT_DB_URL=file:./data/app.db
